# Required
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=

# Optional
DISCORD_ALLOWED_ROLE_IDS=
BOT_NAME_PREFIX=

# Webhook (URL and secret are required together).
# Public HTTPS only; http://127.0.0.1 is allowed for local tests or the optional loopback forwarder.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Optional. Real automations webhook URL when GROK_WEBHOOK_URL is loopback (forwarder fallback).
GROK_WEBHOOK_UPSTREAM=
