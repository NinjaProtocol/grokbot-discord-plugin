{
  "name": "grokbot-discord",
  "version": "1.0.3",
  "description": "Discord connector plugin for Grok Bot and Cursor agents.",
  "type": "module",
  "license": "MIT",
  "author": "NinjaProtocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaProtocol/grokbot-discord.git"
  },
  "homepage": "https://github.com/NinjaProtocol/grokbot-discord",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "grokbot-discord": "./dist/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "mcp.json",
    "plugin.json",
    ".cursor-plugin",
    ".grok-plugin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "ensure": "tsx src/cli.ts ensure",
    "worker-status": "tsx src/cli.ts status",
    "start": "node dist/cli.js gateway",
    "gateway": "tsx src/cli.ts gateway",
    "mcp": "tsx src/cli.ts mcp",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "discord.js": "^14.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "discord",
    "grok-bot",
    "cursor",
    "mcp",
    "plugin"
  ]
}
